{
    "name": "@punyts/statenet",
    "version": "0.1.0",
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "description": "A Node service that persists @punyts/state-sync namespaces and speaks the sync protocol over a WebSocket",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "statenet": "dist/cli.js"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ],
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "start": "node dist/cli.js"
    },
    "keywords": [
        "punyts",
        "state",
        "sync",
        "websocket"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@punyts/core": "^1.0.0",
        "@punyts/state-sync": "^0.8.0",
        "ws": "^8.21.1"
    },
    "devDependencies": {
        "@types/node": "^26.1.1",
        "@types/ws": "^8.18.1",
        "typescript": "^5.9.3",
        "vitest": "^4.1.10"
    }
}
